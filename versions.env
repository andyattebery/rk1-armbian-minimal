# The RK1 image's pins: the Armbian branch the build follows, and the downloads no apt repo serves.
# Sourced by scripts/build.sh, and copied into the build's userpatches/overlay/ so
# customize-image.sh can source it inside the image chroot. uv isn't pinned: customize-image.sh
# installs its latest release. What apt updates in the image, and what it doesn't: README.md,
# Updating.
# Each download is pinned to a URL and its SHA-256, and its comment says why it is at that version.
# A mismatch or a 404 fails the build. Bump a pin by changing its URL and hash together.

# Armbian build framework: the head of its v26.11 branch, which scripts/build.sh resolves at each
# build and records in <name>.img.xz.armbian. The branch pins the kernel commit itself
# (config/sources/git_sources.json). Its packages carry the branch's VERSION, now 26.11.0-trunk,
# which sorts below the 26.11.N releases in Armbian's stable repo, so apt upgrades them to Armbian's
# own (README.md, Updating).
ARMBIAN_BUILD_REPO=https://github.com/armbian/build
ARMBIAN_BUILD_BRANCH=v26.11

# Mali G610 userspace, DDK g29p1: libmali has to match the kernel's kbase driver, which is g29p1
# (g29p1-11eac0) in armbian/linux-rockchip's rk-6.1-rkr7.2, Armbian's vendor kernel, and in
# rk-6.12-rkr1.1, its vendor-next. ginkage has deleted superseded releases before, so a 404 here
# means re-pin to the current one. The deb bundles ginkage's Vulkan WSI layer (vulkan-wsi-layer
# e890be6), an implicit layer that every Vulkan application loads.
# 19878530 bytes.
LIBMALI_URL=https://github.com/ginkage/libmali-rockchip/releases/download/v1.10-1-1163985/libmali-valhall-g610-g29p1_1.10-1_arm64.deb
LIBMALI_SHA256=b17ddcf8295cc97b00ed87438d258e9251c2642e42918c6fdb49c6d91d9a433c

# NPU runtimes, which have to work with the kernel's rknpu driver, 0.9.8 in both of those kernel
# branches. RKNN 2.5.0 (8189368 bytes) is the release of RKNN Toolkit Lite2 below, and ran on rknpu
# 0.9.8 with no driver warning on an RK1. RKLLM 1.3.1 (7674816 bytes) needs 0.9.8. RKNN is under
# Rockchip's RKNN SDK License from 2.5.0 on (licenses/rknn-toolkit2-LICENSE.txt).
RKNNRT_URL=https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v2.5.0/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so
RKNNRT_SHA256=4b6cc575bedf8952b13db4b1190fa3b3d2ac213f00be774ff6ccd19d651970c0
RKLLMRT_URL=https://raw.githubusercontent.com/airockchip/rknn-llm/release-v1.3.1/rkllm-runtime/Linux/librkllm_api/aarch64/librkllmrt.so
RKLLMRT_SHA256=f25e9b099db08aaacd0a3ac62b4697d3951d6ae61ae41ea09f6702cfa89eb32c

# RKNN Toolkit Lite2 2.5.0, the release of the RKNN runtime above. Its last wheel is cp312, so the
# image gets CPython 3.12 from uv.
RKNN_LITE_WHEEL_URL=https://files.pythonhosted.org/packages/25/9c/2b8f974a5b4f54676d51f40a8d21964f3728a15ea665796a882acb5a12da/rknn_toolkit_lite2-2.5.0-cp312-cp312-manylinux_2_17_aarch64.manylinux2014_aarch64.whl
RKNN_LITE_WHEEL_SHA256=5cea0e6ff6e52974debf21719b4499803b5ab62550107274e709846531bf53e1

# Video: jellyfin-ffmpeg8, from repo.jellyfin.org, which may supply it and nothing else
# (userpatches/overlay/jellyfin.pref). apt installs and updates it from there, checked against the
# suite's signed index. This is the key that signs it.
JELLYFIN_KEY_URL=https://repo.jellyfin.org/jellyfin_team.gpg.key
JELLYFIN_KEY_SHA256=a0cde241ae297fa6f0265c0bf15ce9eb9ee97c008904a59ab367a67d59532839
